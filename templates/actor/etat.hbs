<section class="tab etat {{tab.cssClass}}" data-group="primary" data-tab="etat">
  <div class="colonnes deux">
    <div class="pile-encarts">
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.volonte.label"}}</legend>
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.volonte.fields.permanente.label name="system.volonte.permanente" value=source.volonte.permanente max=10 editable=editable}}
      {{formGroup systemFields.volonte.fields.temporaire value=source.volonte.temporaire localize=true disabled=(not editable)}}
      <p class="hint">{{localize "WODHOMEBREW.Fiche.VolontePermanenteEnTete"}}</p>
    </fieldset>
    {{#if estMage}}
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.avatar.label"}}</legend>
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.avatar.label name="system.avatar" value=source.avatar max=@root.echelle editable=editable}}
      <p class="hint">{{localize "WODHOMEBREW.Fiche.AvatarAide"}}</p>
    </fieldset>
    {{/if}}
    </div>

    <fieldset class="sante">
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.sante.label"}}</legend>
      {{formGroup systemFields.sante.fields.niveaux value=source.sante.niveaux localize=true disabled=(not editable)}}
      <p class="hint">{{localize "WODHOMEBREW.Sante.AideClic"}}</p>
      <ol class="niveaux-sante">
        {{#each sante as |n|}}
        <li class="{{#if n.coche}}coche {{n.type}}{{/if}}">
          {{#if @root.editable}}
          <button type="button" class="case" data-action="caseSante" data-type="{{n.type}}"
                  data-tooltip="{{localize "WODHOMEBREW.Sante.Aggraver"}}">{{#if (eq n.type "aggrave")}}✱{{else if (eq n.type "letal")}}X{{else if (eq n.type "contondant")}}/{{/if}}</button>
          {{else}}
          <span class="case">{{#if (eq n.type "aggrave")}}✱{{else if (eq n.type "letal")}}X{{else if (eq n.type "contondant")}}/{{/if}}</span>
          {{/if}}
          <span class="niveau">{{localize n.label}}</span>
          <span class="malus">{{n.malusTexte}}</span>
        </li>
        {{/each}}
      </ol>
      <p class="hint">{{localize "WODHOMEBREW.Sante.Etat"}} : {{localize etatSante}} ({{system.sante.etat.malus}})</p>
    </fieldset>

    {{#if estVampirique}}
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.vertus.label"}}</legend>
      {{#each vertus as |c|}}{{> "systems/wod_homebrew/templates/actor/trait.hbs" label=c.field.label name=c.field.fieldPath value=c.value max=@root.echelle editable=@root.editable}}{{/each}}
    </fieldset>
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.voie.label"}}</legend>
      {{formGroup systemFields.voie.fields.nom value=source.voie.nom localize=true disabled=(not editable)}}
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.voie.fields.valeur.label name="system.voie.valeur" value=source.voie.valeur max=10 editable=editable}}
    </fieldset>
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.sang.label"}}</legend>
      {{formGroup systemFields.sang.fields.valeur value=source.sang.valeur localize=true disabled=(not editable)}}
      {{formGroup systemFields.sang.fields.max value=source.sang.max localize=true disabled=(not editable)}}
      {{formGroup systemFields.sang.fields.par_tour value=source.sang.par_tour localize=true disabled=(not editable)}}
    </fieldset>
    {{/if}}

    {{#if estGarou}}
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.rage.label"}} / {{localize "WODHOMEBREW.Actor.FIELDS.gnose.label"}}</legend>
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.rage.fields.permanente.label name="system.rage.permanente" value=source.rage.permanente max=10 editable=editable}}
      {{formGroup systemFields.rage.fields.temporaire value=source.rage.temporaire localize=true disabled=(not editable)}}
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.gnose.fields.permanente.label name="system.gnose.permanente" value=source.gnose.permanente max=10 editable=editable}}
      {{formGroup systemFields.gnose.fields.temporaire value=source.gnose.temporaire localize=true disabled=(not editable)}}
    </fieldset>
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.renommee.label"}}</legend>
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.renommee.fields.gloire.fields.permanente.label name="system.renommee.gloire.permanente" value=source.renommee.gloire.permanente max=10 editable=editable}}
      {{formGroup systemFields.renommee.fields.gloire.fields.temporaire value=source.renommee.gloire.temporaire localize=true disabled=(not editable)}}
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.renommee.fields.honneur.fields.permanente.label name="system.renommee.honneur.permanente" value=source.renommee.honneur.permanente max=10 editable=editable}}
      {{formGroup systemFields.renommee.fields.honneur.fields.temporaire value=source.renommee.honneur.temporaire localize=true disabled=(not editable)}}
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.renommee.fields.sagesse.fields.permanente.label name="system.renommee.sagesse.permanente" value=source.renommee.sagesse.permanente max=10 editable=editable}}
      {{formGroup systemFields.renommee.fields.sagesse.fields.temporaire value=source.renommee.sagesse.temporaire localize=true disabled=(not editable)}}
    </fieldset>
    {{/if}}

    {{#if estMage}}
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Actor.FIELDS.spheres.label"}}</legend>
      {{#each spheres as |c|}}{{> "systems/wod_homebrew/templates/actor/trait.hbs" label=c.field.label name=c.field.fieldPath value=c.value max=@root.echelle editable=@root.editable}}{{/each}}
    </fieldset>
    <fieldset>
      <legend>{{localize "WODHOMEBREW.Fiche.Magie"}}</legend>
      {{> "systems/wod_homebrew/templates/actor/trait.hbs" label=systemFields.arete.label name="system.arete" value=source.arete max=10 editable=editable}}
      <div class="form-group">
        <label>{{localize systemFields.quintessence.label}}</label>
        <div class="form-fields quintessence">
          <input type="number" name="system.quintessence" value="{{source.quintessence}}" min="0"
                 {{#if (ne system.quintessenceMax null)}}max="{{system.quintessenceMax}}"{{/if}} step="1" {{disabled (not editable)}}>
          {{#if (ne system.quintessenceMax null)}}<span class="max-quintessence" data-tooltip="{{localize "WODHOMEBREW.Jets.QuintessenceMaxAide"}}">/ {{system.quintessenceMax}}</span>{{/if}}
        </div>
      </div>
      {{formGroup systemFields.paradoxe value=source.paradoxe localize=true disabled=(not editable)}}
    </fieldset>
    {{/if}}
  </div>
</section>
